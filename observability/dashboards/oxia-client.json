      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, operation) (rate(oxia_chaos_operation_duration_seconds_bucket{channel=~\"$channel\",case=~\"$case\"}[$__rate_interval])))", "legendFormat": "p95 {{operation}}", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le, operation) (rate(oxia_chaos_operation_duration_seconds_bucket{channel=~\"$channel\",case=~\"$case\"}[$__rate_interval])))", "legendFormat": "p99 {{operation}}", "refId": "B"}
