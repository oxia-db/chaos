      "targets": [{"expr": "sum by (operation) (rate(oxia_chaos_operations_total{channel=~\"$channel\",case=~\"$case\",outcome=\"success\"}[$__rate_interval]))", "legendFormat": "{{operation}}", "refId": "A"}],
