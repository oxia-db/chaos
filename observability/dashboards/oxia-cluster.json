  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "panels": [],
      "title": "Oxia cluster health",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 1},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [
        {"expr": "sum(up{job=\"oxia-chaos-pods\",channel=~\"$channel\",component=~\"oxia-server|oxia-coordinator\"})", "legendFormat": "targets", "refId": "A"}
      ],
      "title": "Oxia metric targets up",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 1},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [
        {"expr": "sum(increase(oxia_coordinator_node_health_checks_failed_count_total{channel=~\"$channel\"}[$__range])) or vector(0)", "legendFormat": "failures", "refId": "A"}
      ],
      "title": "Failed Oxia node health checks",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 1},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [
        {"expr": "sum(increase(k8s_container_restarts{ k8s_namespace_name=\"oxia-chaos\", k8s_pod_name=~\"oxia-chaos-($channel)-.*\"}[$__range]))", "legendFormat": "restarts", "refId": "A"}
      ],
      "title": "Container restarts",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 8, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 5,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum by (pod) (rate(process_cpu_seconds_total{job=\"oxia-chaos-pods\",channel=~\"$channel\",component=~\"oxia-server|oxia-coordinator\"}[$__rate_interval]))", "legendFormat": "{{pod}}", "refId": "A"}
      ],
      "title": "Oxia process CPU",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 8, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 6,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "max by (pod) (process_resident_memory_bytes{job=\"oxia-chaos-pods\",channel=~\"$channel\",component=~\"oxia-server|oxia-coordinator\"})", "legendFormat": "{{pod}}", "refId": "A"}
      ],
      "title": "Oxia process memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 12, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum by (pod) (rate(oxia_server_db_puts_count_total{channel=~\"$channel\"}[$__rate_interval]))", "legendFormat": "put {{pod}}", "refId": "A"},
        {"expr": "sum by (pod) (rate(oxia_server_db_gets_count_total{channel=~\"$channel\"}[$__rate_interval]))", "legendFormat": "get {{pod}}", "refId": "B"}
      ],
      "title": "Oxia database operations",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 8, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "id": 8,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "max by (pod, shard) (oxia_server_wal_entries_count{channel=~\"$channel\"})", "legendFormat": "WAL {{pod}} shard {{shard}}", "refId": "A"},
        {"expr": "max by (pod, shard, follower) (oxia_server_follower_ack_offset_count{channel=~\"$channel\"})", "legendFormat": "ack {{follower}}", "refId": "B"}
      ],
      "title": "Replication offsets",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "${logs}"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 22},
      "id": 9,
      "options": {"dedupStrategy": "none", "enableInfiniteScrolling": false, "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [
        {"editorMode": "code", "expr": "{k8s_namespace_name=\"oxia-chaos\", k8s_container_name=~\"server|coordinator\"} |~ `(?i)(error|panic|fatal|leader|election|closed)`", "queryType": "range", "refId": "A"}
      ],
      "title": "Oxia server and coordinator events",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["oxia", "chaos", "correctness", "cluster"],
